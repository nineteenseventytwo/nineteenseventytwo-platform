---
# Copy to secrets.sops.yml, fill in, then:
#   sops --encrypt --in-place ansible/inventory/lab/group_vars/all/secrets.sops.yml
#
# The community.sops vars plugin decrypts this at run time, so playbooks just
# reference the keys as ordinary variables. Never commit the decrypted form —
# .gitignore does not save you here, the filename is the same.
#
# Nothing in this file should outlive Phase D: once Vault + ESO are up, cluster
# workload secrets move there and only the bootstrap credentials stay.

# GitHub App used for runner registration (§3.4). Replaces hand-pasted,
# hour-expiring registration tokens.
github_app_id: "000000"
github_app_installation_id: "00000000"
github_app_private_key: |
  -----BEGIN RSA PRIVATE KEY-----
  ...
  -----END RSA PRIVATE KEY-----

# Cloudflare token for cert-manager DNS-01. Scope: Zone:DNS:Edit on the single
# lab_domain zone. Moves into Vault in Phase D; ESO projects it from there.
cloudflare_api_token: "..."

# AWS credentials for Vault's KMS auto-unseal. Prefer an instance/OIDC role;
# these static keys are the fallback for the bootstrap window only.
vault_kms_key_id: "arn:aws:kms:us-east-2:000000000000:key/00000000-0000-0000-0000-000000000000"
vault_kms_region: "us-east-2"
