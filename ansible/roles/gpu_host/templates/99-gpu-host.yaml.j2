# Managed by ansible/roles/gpu_host. Edits here are overwritten.
#
# systemd-networkd defaults to ClientIdentifier=duid: it sends an RFC 4361
# IAID+DUID derived from /etc/machine-id as DHCP option 61, not the hardware
# address. Windows sends the RFC 2132 form — type 01 followed by the MAC.
#
# One NIC, two boots, two identities. Kea matched the 192.168.20.210
# reservation for the Windows boot and dropped the Linux boot into the pool at
# 192.168.20.100, which is not where the inventory, composer's LLM_BASE_URL,
# its NetworkPolicy egress rule or the eightbitsaxlounge midi manifests expect
# this host to be. Nothing was broken enough to notice: the machine was up,
# answering SSH, and simply somewhere else.
#
# `mac` makes networkd send 01 + MAC, byte for byte what the Windows boot
# sends, so one reservation now covers both.
#
# `wakeonlan: true` becomes WakeOnLan=magic in networkd, which is the
# equivalent of `ethtool -s <if> wol g`. The NIC supports it — `Supports
# Wake-on: pumbg`, the g being magic packet — but ships disabled (`Wake-on:
# d`) and an ethtool call does not survive a reboot, which is the whole reason
# this belongs in configuration rather than in a runbook.
#
# It is half the story. The driver accepting `g` does not mean the board will
# wake: the UEFI has its own Wake-on-LAN setting, and with that off the
# magic packet is received by a NIC nothing is listening to. Windows Fast
# Startup matters here too and is already disabled — a hibernated Windows can
# leave the NIC in a state that will not wake at all.
network:
  version: 2
  ethernets:
    {{ gpu_host_dhcp_interface }}:
      dhcp4: true
      dhcp-identifier: mac
      wakeonlan: true
