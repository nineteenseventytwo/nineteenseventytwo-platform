# Managed by ansible/roles/kube_control_plane. Do not edit on the host.
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ hostvars['1972-master-1'].ansible_host }}
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ ansible_host }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "v{{ kubernetes_version }}.0"
clusterName: nineteenseventytwo
controlPlaneEndpoint: "{{ hostvars['1972-master-1'].ansible_host }}:6443"
networking:
  podSubnet: "{{ kubernetes_pod_cidr }}"
  serviceSubnet: "{{ kubernetes_service_cidr }}"
  dnsDomain: cluster.local
apiServer:
  certSANs:
{% for san in kubernetes_apiserver_extra_sans %}
    - "{{ san }}"
{% endfor %}
    - "{{ hostvars['1972-master-1'].ansible_host }}"
  extraArgs:
    - name: encryption-provider-config
      value: {{ kube_control_plane_encryption_key_path }}
    - name: admission-control-config-file
      value: {{ kube_control_plane_admission_config_path }}
    - name: audit-log-path
      value: /var/log/kubernetes/audit.log
    - name: audit-log-maxage
      value: "14"
    - name: audit-log-maxbackup
      value: "3"
    - name: audit-log-maxsize
      value: "50"
  extraVolumes:
    - name: encryption-config
      hostPath: /etc/kubernetes/enc
      mountPath: /etc/kubernetes/enc
      readOnly: true
      pathType: DirectoryOrCreate
    - name: admission-config
      hostPath: /etc/kubernetes/admission
      mountPath: /etc/kubernetes/admission
      readOnly: true
      pathType: DirectoryOrCreate
    - name: audit-log
      hostPath: /var/log/kubernetes
      mountPath: /var/log/kubernetes
      readOnly: false
      pathType: DirectoryOrCreate
controllerManager:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
scheduler:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# 2 GB nodes. Matches the systemd drop-in written by kube_prereqs.
systemReserved:
  memory: "{{ kubelet_system_reserved_memory }}"
kubeReserved:
  memory: "{{ kubelet_kube_reserved_memory }}"
evictionHard:
  memory.available: "{{ kubelet_eviction_hard_memory }}"
serverTLSBootstrap: true
