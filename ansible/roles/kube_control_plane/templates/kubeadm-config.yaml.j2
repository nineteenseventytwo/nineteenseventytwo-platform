---
# Managed by ansible/roles/kube_control_plane. Do not edit on the host.
#
# kubeadm's own config parser (SplitConfigDocuments) splits this file on
# every `---` line and requires each resulting chunk to carry apiVersion and
# kind — a comment-only chunk before the first `---` fails with "invalid
# configuration for GroupVersionKind /, Kind=: kind and apiVersion is
# mandatory", which is why this comment lives after the first `---` and not
# before it. Confirmed against the real kubeadm binary (v1.36.4), not just
# read from the error message.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ hostvars['1972-master-1'].ansible_host }}
  bindPort: 6443
nodeRegistration:
  criSocket: unix:///run/containerd/containerd.sock
  kubeletExtraArgs:
    - name: node-ip
      value: {{ ansible_host }}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "v{{ kubernetes_version }}.0"
clusterName: nineteenseventytwo
controlPlaneEndpoint: "{{ hostvars['1972-master-1'].ansible_host }}:6443"
networking:
  podSubnet: "{{ kubernetes_pod_cidr }}"
  serviceSubnet: "{{ kubernetes_service_cidr }}"
  dnsDomain: cluster.local
apiServer:
  certSANs:
{% for san in kubernetes_apiserver_extra_sans %}
    - "{{ san }}"
{% endfor %}
    - "{{ hostvars['1972-master-1'].ansible_host }}"
  extraArgs:
    # ---------------------------------------------------------------------
    # IRSA. This is a ONE-WAY DOOR: the service account issuer is fixed at
    # `kubeadm init`. Changing it later means restarting the control plane and
    # invalidating every projected service-account token in the cluster.
    #
    # The issuer must be a public HTTPS URL that AWS can resolve, because STS
    # fetches the JWKS from it to verify tokens pods present. It is served by a
    # Cloudflare Worker in front of an S3 bucket that the cluster itself
    # publishes into — see docs/06-aws-federation.md.
    #
    # api-audiences keeps `https://kubernetes.default.svc` FIRST so ordinary
    # in-cluster tokens and TokenReview (Vault's kubernetes auth, which ESO
    # depends on) keep working exactly as before; `sts.amazonaws.com` is
    # additive, and only tokens explicitly projected with that audience carry
    # it.
    # ---------------------------------------------------------------------
    - name: service-account-issuer
      value: {{ cluster_oidc_issuer }}
    - name: service-account-jwks-uri
      value: {{ cluster_oidc_issuer }}/openid/v1/jwks
    - name: api-audiences
      value: https://kubernetes.default.svc,{{ cluster_oidc_audience }}
    - name: encryption-provider-config
      value: {{ kube_control_plane_encryption_key_path }}
    - name: admission-control-config-file
      value: {{ kube_control_plane_admission_config_path }}
    - name: audit-log-path
      value: /var/log/kubernetes/audit.log
    - name: audit-log-maxage
      value: "14"
    - name: audit-log-maxbackup
      value: "3"
    - name: audit-log-maxsize
      value: "50"
    - name: audit-policy-file
      value: {{ kube_control_plane_audit_policy_path }}
  extraVolumes:
    - name: encryption-config
      hostPath: /etc/kubernetes/enc
      mountPath: /etc/kubernetes/enc
      readOnly: true
      pathType: DirectoryOrCreate
    - name: admission-config
      hostPath: /etc/kubernetes/admission
      mountPath: /etc/kubernetes/admission
      readOnly: true
      pathType: DirectoryOrCreate
    - name: audit-policy
      hostPath: /etc/kubernetes/audit
      mountPath: /etc/kubernetes/audit
      readOnly: true
      pathType: DirectoryOrCreate
    - name: audit-log
      hostPath: /var/log/kubernetes
      mountPath: /var/log/kubernetes
      readOnly: false
      pathType: DirectoryOrCreate
controllerManager:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
scheduler:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
# 2 GB nodes. Matches the systemd drop-in written by kube_prereqs.
systemReserved:
  memory: "{{ kube_prereqs_kubelet_system_reserved_memory }}"
kubeReserved:
  memory: "{{ kube_prereqs_kubelet_kube_reserved_memory }}"
evictionHard:
  memory.available: "{{ kube_prereqs_kubelet_eviction_hard_memory }}"
serverTLSBootstrap: true
