# Managed by ansible/roles/runner_host. Do not edit on the host.
[Unit]
Description=GitHub Actions runner stack (org-scoped, ephemeral)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory={{ runner_home }}
ExecStart=/usr/bin/docker compose -f compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
