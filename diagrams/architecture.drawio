        <mxCell id="obs" value="OBSERVE &amp; DETECT&#10;monitoring: Prometheus 3.15, Alertmanager,&#10;   Grafana (LAN, Gateway) · node-exporter&#10;falco: eBPF runtime detection, every node&#10;kubescape: nightly NSA gate vs accepted list&#10;findings: exporter + &#x27;Findings&#x27; dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
