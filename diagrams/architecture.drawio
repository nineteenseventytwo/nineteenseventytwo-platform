        <mxCell id="secrets" value="SECRETS &amp; IDENTITY&#10;vault (KMS auto-unseal over IRSA, SSH CA)&#10;external-secrets: Vault → Secrets&#10;pod-identity-webhook: IRSA for non-EKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
