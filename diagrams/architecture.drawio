        <mxCell id="gpu" value="1972-gpu-1  (.210)  NOT a node&#10;Linux: Ollama behind Caddy&#10;(allowlisted paths, ufw: nodes only)&#10;Windows: midi PC build + the&#10;physical MIDI device (ADR-0020)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
