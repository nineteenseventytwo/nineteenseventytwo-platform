        <mxCell id="policy" value="POLICY  (policy/, wave 95)&#10;namespaces + Pod Security labels · default-deny&#10;in every namespace · LimitRange · quota · RBAC&#10;observe-dns: pod DNS through Cilium&#x27;s proxy (6.4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
