        <mxCell id="w20n" value="98" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="984" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w20a" value="dash → dash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="984" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w20s" value="repo path: cluster/dash&#10;8bsl status page (ADR-0018 W5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="984" width="380" height="38" as="geometry" /></mxCell>
        <mxCell id="w21n" value="99" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="1032" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w21a" value="cloudflared → cloudflared" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="1032" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w21s" value="repo path: cluster/cloudflared&#10;tunnel to dash., Access-gated (ADR-0021)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="1032" width="380" height="38" as="geometry" /></mxCell>
        <mxCell id="w22n" value="100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="1080" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w22a" value="apps (ApplicationSet)&#10;→ ns: {app}-{env}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="1080" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w22s" value="git generator over apps/*/*&#10;one Application per app/env (eightbitsaxlounge, composer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="1080" width="380" height="38" as="geometry" /></mxCell>
        <mxCell id="eArgoLadder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;" edge="1" parent="1" source="argocd"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="eGitArgo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="srcBootstrap" target="argocd"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Right annotations -->
        <mxCell id="annBox" value="WHAT THE ORDER IS ACTUALLY FOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="30" width="480" height="870" as="geometry" />
        </mxCell>

        <mxCell id="ann1" value="Sync waves are ORDERING, not dependency&#10;resolution. Argo CD waits for a wave to report&#10;Healthy before starting the next. Nothing here&#10;declares &quot;X needs Y&quot; — the numbers encode it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="60" width="450" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ann2" value="-20 · Cilium first, or nothing has a network.&#10;Flannel could not enforce NetworkPolicy at all,&#10;which is why the CNI changed (ADR-0003)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="140" width="450" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ann3" value="20 → 25 · cert-manager must be issuing before&#10;pod-identity-webhook, which needs a serving&#10;certificate to pass admission at all." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="205" width="450" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ann4" value="25 → 30/50 · the webhook lands before Longhorn&#10;and Vault start, so their pods get IRSA credentials&#10;injected at admission time. Too late = no creds,&#10;no error near the pod (failurePolicy: Ignore)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="270" width="450" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ann5" value="40 → 50 · ESO installed before Vault, but ESO&#10;cannot RESOLVE an ExternalSecret until Vault is&#10;unsealed and populated. Install order and&#10;working order are not the same thing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="350" width="450" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ann6" value="95 · policy/ creates every namespace with its PSS label,&#10;default-deny, LimitRange, quota and ServiceAccounts —&#10;so anything that needs those must come AFTER it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="430" width="450" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ann7" value="100 · tenants never get a kubeconfig. The platform&#10;owns their namespaces (ADR-0004, ADR-0012); an&#10;app repo contributes a directory, not cluster access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="495" width="450" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ann8" value="96–99 · falco, findings, dash and cloudflared need what&#10;90 and 95 create: a privileged-labelled namespace, a&#10;ServiceAccount, the ClusterSecretStore. The parent app&#10;waits for each wave to be Healthy, so at 75/83/84 a&#10;rebuild would have hung forever (#236, #240)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="560" width="450" height="130" as="geometry" />
        </mxCell>

        <mxCell id="ann9" value="85 · kubescape can sit before 95: a CronJob is Healthy&#10;with no pods, and its ServiceAccount only matters at&#10;03:30, long after policy/ has synced." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="700" width="450" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ann10" value="The ApplicationSet itself must carry wave 100. The&#10;wave on its TEMPLATE orders nothing in this app: the&#10;Applications it generates are not the parent's children.&#10;Without it, tenant apps sync at wave 0 — before their&#10;namespaces, default-deny and secret store exist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="780" width="450" height="100" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legendBox" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="1180" y="920" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="legendTitle" value="Legend" style="text;html=1;fontStyle=1;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1192" y="926" width="100" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="green = platform component" style="text;html=1;fontSize=10;align=left;fontColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1192" y="948" width="220" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="purple = in the AWS-credential path (IRSA / Vault)" style="text;html=1;fontSize=10;align=left;fontColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1192" y="966" width="330" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="orange = policy / guardrail" style="text;html=1;fontSize=10;align=left;fontColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1192" y="984" width="220" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="blue = tenant workloads" style="text;html=1;fontSize=10;align=left;fontColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1192" y="1002" width="220" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg6" value="red = security tooling (Phase 10)" style="text;html=1;fontSize=10;align=left;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1192" y="1020" width="260" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="★ = the only step a human performs" style="text;html=1;fontSize=10;align=left;fontColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1192" y="1038" width="260" height="16" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
