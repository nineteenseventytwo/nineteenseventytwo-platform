        <mxCell id="w10a" value="arc-controller  →  arc-systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="504" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w10s" value="gha-runner-scale-set-controller @ 0.14.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="504" width="380" height="38" as="geometry" /></mxCell>

        <mxCell id="w11n" value="80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="552" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w11a" value="arc-lab-deploy  →  arc-runners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="552" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w11s" value="gha-runner-scale-set @ 0.14.2  (deploy runners)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="552" width="380" height="38" as="geometry" /></mxCell>

        <mxCell id="w12n" value="80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="600" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w12a" value="arc-lab-dind  →  arc-runners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="600" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w12s" value="gha-runner-scale-set @ 0.14.2  (docker-in-docker)&#10;same wave as arc-lab-deploy — no ordering between them" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="600" width="380" height="38" as="geometry" /></mxCell>

        <mxCell id="w13n" value="90" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="648" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w13a" value="platform-manifests  →  (multi-ns)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="648" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w13s" value="repo path: cluster/&#10;ExternalSecrets, Certificates, Ingresses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="648" width="380" height="38" as="geometry" /></mxCell>

        <mxCell id="w14n" value="95" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="696" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w14a" value="platform-policy  →  (all namespaces)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="696" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w14s" value="repo path: policy/&#10;namespaces · default-deny NetworkPolicy · LimitRange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="696" width="380" height="38" as="geometry" /></mxCell>

        <mxCell id="w15n" value="100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;arcSize=30;" vertex="1" parent="1"><mxGeometry x="380" y="744" width="55" height="38" as="geometry" /></mxCell>
        <mxCell id="w15a" value="apps  (ApplicationSet)&#10;→  ns: {tenant}-{app}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="450" y="744" width="300" height="38" as="geometry" /></mxCell>
        <mxCell id="w15s" value="git generator over apps/*/*&#10;one child Application per tenant app dir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="770" y="744" width="380" height="38" as="geometry" /></mxCell>

        <mxCell id="eArgoLadder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;" edge="1" parent="1" source="argocd"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="eGitArgo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="srcBootstrap" target="argocd"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Right annotations -->
        <mxCell id="annBox" value="WHAT THE ORDER IS ACTUALLY FOR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1180" y="30" width="480" height="500" as="geometry" />
        </mxCell>

        <mxCell id="ann1" value="Sync waves are ORDERING, not dependency&#10;resolution. Argo CD waits for a wave to report&#10;Healthy before starting the next. Nothing here&#10;declares &quot;X needs Y&quot; — the numbers encode it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="60" width="450" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ann2" value="-20 · Cilium first, or nothing has a network.&#10;Flannel could not enforce NetworkPolicy at all,&#10;which is why the CNI changed (ADR-0003)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="140" width="450" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ann3" value="20 → 25 · cert-manager must be issuing before&#10;pod-identity-webhook, which needs a serving&#10;certificate to pass admission at all." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="205" width="450" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ann4" value="25 → 30/50 · the webhook lands before Longhorn&#10;and Vault start, so their pods get IRSA credentials&#10;injected at admission time. Too late = no creds,&#10;no error near the pod (failurePolicy: Ignore)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="270" width="450" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ann5" value="40 → 50 · ESO installed before Vault, but ESO&#10;cannot RESOLVE an ExternalSecret until Vault is&#10;unsealed and populated. Install order and&#10;working order are not the same thing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="350" width="450" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ann6" value="95 · policy/ lands LAST among platform waves but&#10;BEFORE tenant apps at 100 — every namespace is&#10;default-deny before a tenant workload exists in it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="430" width="450" height="55" as="geometry" />
        </mxCell>

        <mxCell id="ann7" value="100 · tenants never get a kubeconfig. The platform&#10;owns their namespaces (ADR-0004, ADR-0012); an&#10;app repo contributes a directory, not cluster access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1195" y="495" width="450" height="55" as="geometry" />
        </mxCell>

        <!-- Legend -->
