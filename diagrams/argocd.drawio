        <mxCell id="title" value="Argo CD — what it syncs, and in what order (cluster/argocd/applications/)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="-30" width="1000" height="30" as="geometry" />
        </mxCell>

        <!-- Left rail: sources and bootstrap -->
        <mxCell id="railBox" value="SOURCES &amp; BOOTSTRAP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="320" height="700" as="geometry" />
        </mxCell>

        <mxCell id="srcGit" value="git: nineteenseventytwo-platform@main&#10;cluster/argocd/applications/*.yaml&#10;(app-of-apps — the only thing applied by hand)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="60" width="290" height="60" as="geometry" />
        </mxCell>

        <mxCell id="srcHelm" value="upstream Helm repos&#10;helm.cilium.io · metallb.github.io · charts.jetstack.io&#10;charts.longhorn.io · charts.external-secrets.io&#10;helm.releases.hashicorp.com · prometheus-community&#10;falcosecurity · postfinance · ghcr.io/actions/...-charts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="135" width="290" height="80" as="geometry" />
        </mxCell>

        <mxCell id="srcMulti" value="Most apps are MULTI-SOURCE:&#10;upstream chart + values from this repo&#10;($values ref) — chart version pinned in&#10;the Application, values reviewed in git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="230" width="290" height="65" as="geometry" />
        </mxCell>

        <mxCell id="srcBootstrap" value="make bootstrap-argocd&#10;installs Argo CD itself, then applies&#10;the Application manifests above" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#d6b656;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="315" width="290" height="60" as="geometry" />
        </mxCell>

        <mxCell id="argocd" value="Argo CD&#10;namespace: argocd&#10;reconciles every Application below&#10;against git, continuously" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="395" width="290" height="70" as="geometry" />
        </mxCell>

        <mxCell id="noteRestart" value="&#9733; ONE MANUAL STEP&#10;Argo CD is installed BEFORE the&#10;pod-identity-webhook exists, so&#10;argocd-repo-server never passed&#10;through admission and carries no&#10;injected AWS credentials.&#10;kubectl -n argocd rollout restart&#10;  deploy/argocd-repo-server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="485" width="290" height="110" as="geometry" />
        </mxCell>

        <mxCell id="noteSync" value="make argocd-sync-wait&#10;blocks until every Application&#10;reports Synced/Healthy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="610" width="290" height="55" as="geometry" />
        </mxCell>

        <mxCell id="noteGate" value="deploy-cluster.yml (CI) nudges Argo CD&#10;and waits — CI does not apply manifests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="675" width="290" height="45" as="geometry" />
