        <mxCell id="title" value="Security awareness — what generates a signal, where it lands, and what actually wakes someone up" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="-30" width="1200" height="30" as="geometry" />
        </mxCell>

        <!-- Column headers -->
        <mxCell id="hdr1" value="1 — SOURCES" style="text;html=1;align=left;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
