            <mxPoint x="1250" y="860" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- PHASE A -->
        <mxCell id="A1" value="ssh-keygen -t ed25519&#10;mark-workstation + ansible-workstation&#10;-&gt; cp *.pub to bootstrap/ssh/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="65" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="A2" value="make bootstrap-render HOST=&lt;node&gt;&#10;renders cloud-init user-data&#10;(embeds public key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="310" height="50" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="Kea: create DHCP reservation per Pi MAC&#10;(addressing authority - ADR-0009)&#10;must exist BEFORE first boot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="205" width="310" height="55" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="Flash vanilla Ubuntu 24.04 arm64&#10;(Pi Imager - no advanced options panel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="295" width="310" height="55" as="geometry" />
        </mxCell>
        <mxCell id="A5" value="&#9733; MANUAL STEP: copy user-data +&#10;network-config onto boot partition -&gt; boot&#10;cloud-init applies pubkey to authorized_keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#82b366;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="310" height="55" as="geometry" />
        </mxCell>

        <!-- PHASE B -->
        <mxCell id="B1" value="age-keygen&#10;add pubkey (+ CI's) to .sops.yaml&#10;sops --encrypt secrets.sops.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="65" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="make test-network&#10;(validation matrix, run on the Pi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="295" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="make deploy-nodes&#10;Ansible hardening baseline&#10;(uses ansible-workstation key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="355" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="20-cicd-host.yml on console-1&#10;generates ansible-console key&#10;(never leaves the host)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="415" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- PHASE C -->
        <mxCell id="C4" value="make deploy-cluster&#10;kubeadm init bakes in&#10;--service-account-issuer (permanent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="295" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="C5" value="make publish-oidc&#10;uploads discovery docs to S3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="360" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="C6" value="make bootstrap-argocd&#10;Argo CD deploys Vault +&#10;External Secrets Operator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="295" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="C7" value="Vault auto-unseals via AWS KMS&#10;(IRSA, cluster-vault-unseal role)&#10;no static credential in cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e6ff;strokeColor=#9673a6;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="360" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="C1" value="Terraform: create_jwks_bucket=true&#10;S3 bucket for OIDC discovery docs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="615" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="C2" value="publish_cluster_oidc=true&#10;register IAM OIDC provider&#10;+ create 4 IAM roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="615" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="C3" value="AWS STS verifies pod SA tokens against the published JWKS -&gt; AssumeRoleWithWebIdentity (Vault, Longhorn, Argo CD, Prowler each get one scoped role)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="680" width="530" height="55" as="geometry" />
        </mxCell>
        <mxCell id="C8" value="Deploy OIDC Worker (bootstrap/oidc/worker.js) for eightbitsaxlounge.com&#10;Route oidc.eightbitsaxlounge.com/* -&gt; Worker&#10;(proxies to S3 origin over real TLS, so discovery docs are reachable publicly)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="765" width="530" height="70" as="geometry" />
        </mxCell>

        <!-- PHASE D -->
        <mxCell id="D1" value="&#9733; ./bootstrap/ssh/sign.sh &lt;pi-ip&gt;&#10;Vault signs your pubkey -&gt;&#10;5-minute SSH certificate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9e6;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="65" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="D2" value="Vault: enable ssh-client-signer,&#10;generate CA signing key&#10;vault read ca.pub -&gt; bootstrap/ssh/ca.pub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e6ff;strokeColor=#9673a6;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="295" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="D3" value="hardening role drops ca.pub on every Pi&#10;/etc/ssh/ca.pub, sets TrustedUserCAKeys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="365" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="D4" value="legacy authorized_keys retired&#10;(hardening_ssh_retire_legacy_keys)&#10;except break-glass key, kept fully offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="430" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="D5" value="cert-manager + Let's Encrypt DNS-01&#10;(Cloudflare token from Vault via ESO)&#10;+ internal-ca ClusterIssuer for mTLS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="495" width="360" height="60" as="geometry" />
