        <mxCell id="D6" value="Zone:DNS:Edit token (single zone)&#10;scoped for DNS-01 challenge responses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="765" width="360" height="55" as="geometry" />
