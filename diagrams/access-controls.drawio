<mxfile host="app.diagrams.net" modified="2026-10-28T00:00:00.000Z" agent="Claude Code" version="24.0.0" type="device">
  <diagram name="Access Controls" id="access-controls-1">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Access controls, outside in — five enforcement layers, each covering a different blind spot  (updated 2026-10-28)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="-30" width="1100" height="30" as="geometry" />
        </mxCell>

        <!-- ===== L0: ORIGINS ===== -->
        <mxCell id="l0" value="ORIGINS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="o1" value="VLAN 10 — Trusted&#10;my workstation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o2" value="Internet&#10;(no inbound path into VLAN 20 —&#10;only the Cloudflare tunnel, which&#10;the lab dials OUT to; Layer 5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="50" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o3" value="VLAN 30 / 40&#10;IoT · Guest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="50" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o4" value="Pod on VLAN 20&#10;(a compromised workload — the origin&#10;the outer layers cannot filter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="50" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="Pod needing AWS&#10;(Vault, Longhorn, Argo CD,&#10;findings-exporter)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e6ff;strokeColor=#9673a6;fontSize=11;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="50" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- ===== L1: OPNSENSE ===== -->
        <mxCell id="l1" value="LAYER 1 — OPNSENSE   ·   inter-VLAN routing, DHCP authority, DNS, egress" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="150" width="1160" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="FIREWALL RULES&#10;· Trusted → !Internal_Networks  (internet)&#10;· Trusted → Lab_Nodes on 22, 6443, 443&#10;· Lab → !Internal_Networks, protocol ANY&#10;   (not TCP — ICMP is not TCP, and the&#10;    gateway ping test fails if you get&#10;    this wrong)&#10;· VLAN 20 → VLAN 10/30/40 DENIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="280" height="145" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="KEA DHCP — addressing authority&#10;(ADR-0009)&#10;· pool            .100 – .199&#10;· node reservations  .201 – .204&#10;· MetalLB        .240 – .250&#10;&#10;These three MUST NOT overlap. An overlap&#10;presents as a service that works until the&#10;pool hands out an address MetalLB is&#10;already announcing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="335" y="180" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="UNBOUND DNS&#10;host overrides under eightbitsaxlounge.com&#10;· 1972-console-1 / master-1 / worker-1 / worker-2&#10;· argocd. · vault. · grafana.&#10;NO override for private hostnames (dash.):&#10;those are tunnel-only, even at home (ADR-0021)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="180" width="280" height="145" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="SQUID — LOG-ONLY since 2026-10-27&#10;VLAN 20 → anything, every request logged&#10;(07 Phase 6.4). Nodes use it: shell,&#10;dockerd and containerd proxy configs&#10;(egress_proxy_enabled). Pods do NOT —&#10;see Layer 3&#x27;s DNS observation. The&#10;allowlist is Phase 7, built from both logs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="935" y="180" width="225" height="145" as="geometry" />
        </mxCell>

        <!-- ===== L2: NODE UFW ===== -->
        <mxCell id="l2" value="LAYER 2 — NODE UFW   ·   defence in depth on the host itself" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="360" width="1160" height="180" as="geometry" />
        </mxCell>
        <mxCell id="u1" value="DEFAULTS&#10;incoming: deny&#10;outgoing: allow&#10;&#10;ufw is stopped from managing sysctls&#10;(/etc/default/ufw) — it re-applied them&#10;on every reload and fought Ansible forever" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="CLUSTER PORTS  (lab_subnet + pod CIDR)&#10;6443  apiserver · 2379:2380 etcd · 10250 kubelet&#10;10256 kube-proxy health · 30000:32767 NodePorts&#10;4240 · 4244 cilium health · hubble peer&#10;8472/udp vxlan · 51871/udp wireguard&#10;7946 tcp+udp metallb memberlist&#10;metrics: 9100 node-exporter · 10257 / 10259&#10;controller-manager / scheduler · 2381 etcd&#10;9965 hubble (missing until 2026-10-27, #254)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="335" y="390" width="290" height="135" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="SSH — port 22, allow_users = admin_user only&#10;PasswordAuthentication no (enforced state,&#10;not just first-boot state)&#10;&#10;6443 also opened from VLAN 10 directly, scoped&#10;to that one port rather than folded into the&#10;cluster rules — which would also expose etcd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="390" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="WHY THE POD CIDR IS A SOURCE&#10;&#10;Same-node hairpin: a pod reaching a&#10;hostNetwork Service whose backend is its&#10;OWN node. The packet never leaves the box,&#10;nothing masquerades it, and it arrives still&#10;carrying the pod source IP — which&#10;lab_subnet does not match." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="935" y="390" width="225" height="135" as="geometry" />
        </mxCell>

        <!-- ===== L3: CILIUM NETWORKPOLICY ===== -->
        <mxCell id="l3" value="LAYER 3 — CILIUM NETWORKPOLICY   ·   policy/ , sync wave 95, before any tenant workload exists" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="1160" height="260" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="DEFAULT-DENY, PER NAMESPACE&#10;podSelector: {} , policyTypes: [Ingress, Egress]&#10;&#10;argocd · arc-runners · arc-systems · cert-manager&#10;cloudflared · composer-dev · dash · default&#10;eightbitsaxlounge-dev/-prod · external-secrets&#10;falco · findings · kubelet-csr-approver · kubescape&#10;longhorn-system · metallb-system · monitoring&#10;pod-identity-webhook · security · vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="THE EXCEPTIONS, EACH DELIBERATE&#10;allow-dns-egress     every ns&#10;allow-*-apiserver    controllers need the API&#10;allow-*-webhook-ingress  the API must reach them&#10;allow-prometheus-scrape-*  + grafana → its datasources&#10;cloudflared → dash:8080 only; dash ← cloudflared only&#10;alertmanager ← falcosidekick, kubescape, findings&#10;observe-dns (CCNP, 6.4): every pod&#x27;s DNS through&#10;Cilium&#x27;s DNS proxy, enableDefaultDeny: false —&#10;observes, never blocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="335" y="590" width="290" height="175" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="NOT COVERED — omitted, not missed&#10;kube-system      CoreDNS + the CNI itself live&#10;                 here; a wrong rule takes the&#10;                 cluster down and Argo CD with it&#10;                 before anything could fix it&#10;cilium-secrets&#10;kube-node-lease&#10;kube-public      no tenant-adjacent workloads&#10;node-exporter-system   every pod is&#10;                 hostNetwork: true by construction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="640" y="590" width="280" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="LIVE-VERIFIED, NOT PATTERN-MATCHED&#10;&#10;2026-08-23: a deny-all ingress policy applied&#10;to node-exporter-system left an already-&#10;working Prometheus scrape target completely&#10;unaffected.&#10;&#10;Standard NetworkPolicy does not govern&#10;host-networked traffic in this cluster at all.&#10;That is a real gap, written down rather than&#10;assumed away." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="935" y="590" width="225" height="160" as="geometry" />
        </mxCell>

        <!-- ===== L4: IRSA ===== -->
        <mxCell id="l4" value="LAYER 4 — IAM / IRSA   ·   who a pod is once it leaves the lab entirely" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="840" width="1160" height="270" as="geometry" />
        </mxCell>
        <mxCell id="i1" value="1. pod-identity-webhook injects a projected&#10;    ServiceAccount token, aud=sts.amazonaws.com&#10;2. pod calls AssumeRoleWithWebIdentity&#10;3. STS fetches the JWKS from&#10;    oidc.eightbitsaxlounge.com (Cloudflare → S3)&#10;4. STS verifies the signature and the&#10;    sub / aud conditions on the role&#10;5. 1 hour of credentials, one role, auto-refreshed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="870" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="i2" value="ONE ROLE PER SERVICE ACCOUNT — never a shared &quot;cluster&quot; role&#10;&#10;vault:vault                                → cluster-vault-unseal        Encrypt/Decrypt on the unseal CMK&#10;longhorn-system:longhorn-service-account    → cluster-longhorn-backup     R/W on the backup bucket + its key&#10;findings:findings-exporter                  → cluster-findings-exporter   READ the newest Prowler report&#10;&#10;The webhook only mutates pods in an allowlisted namespace — a new federated&#10;workload needs its namespace added there AND its role (findings, #241)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="435" y="870" width="725" height="125" as="geometry" />
        </mxCell>
        <mxCell id="i3" value="THE BOUNDARY IS THE TRUST POLICY, NOT THE NETWORK.&#10;The JWKS is public — public signing keys, the same thing Google and GitHub publish. AWS STS never calls into the lab; it fetches a public key and verifies a signature on a token it was handed.&#10;Anyone can read the JWKS; only this API server can sign a token satisfying both the sub and aud conditions, and only for a service account that exists." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#6c8ebf;fontSize=10;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="1120" height="85" as="geometry" />
        </mxCell>

        <!-- Spine arrows between layers -->
        <mxCell id="s01" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="132" as="sourcePoint" /><mxPoint x="600" y="150" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s12" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="342" as="sourcePoint" /><mxPoint x="600" y="360" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s23" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="542" as="sourcePoint" /><mxPoint x="600" y="560" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="s34" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="822" as="sourcePoint" /><mxPoint x="600" y="840" as="targetPoint" /></mxGeometry>
        </mxCell>

        <!-- ===== RIGHT RAIL: blind spots ===== -->
        <mxCell id="rail" value="WHAT EACH LAYER CANNOT SEE&#10;(this is the argument for the next one)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="20" width="450" height="1280" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="OPNSENSE CANNOT SEE&#10;&#10;Pi-to-Pi traffic on VLAN 20. It is switch-local —&#10;it never reaches the router, so NO firewall rule&#10;can constrain it.&#10;&#10;This is network-check.sh test 11, and it is the&#10;conceptually important one: it passes, and the&#10;firewall never sees the packet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="60" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b1x" value="→ so node-level UFW exists (Layer 2):&#10;    it is what stops a compromised pod from&#10;    reaching a neighbour's sshd." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="220" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="UFW CANNOT SEE&#10;&#10;Pod-to-pod traffic inside the cluster overlay.&#10;It filters at the host boundary; two pods on the&#10;same node never cross it, and traffic between&#10;nodes is encapsulated (vxlan / wireguard) — UFW&#10;sees the tunnel, not the conversation inside it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="330" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b2x" value="→ so inter-workload isolation is a&#10;    NETWORKPOLICY problem (Layer 3), and&#10;    the CNI had to become Cilium — Flannel&#10;    cannot enforce NetworkPolicy at all&#10;    (ADR-0003)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="470" width="420" height="85" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="NETWORKPOLICY CANNOT SEE&#10;&#10;· host-networked pods — confirmed live, not&#10;   assumed (node-exporter-system, 2026-08-23)&#10;· anything once the packet has left the cluster&#10;· WHO a workload is to an external service —&#10;   a NetworkPolicy allows an egress path, it&#10;   does not authenticate the caller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="600" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="b3x" value="→ so identity moves to IAM/IRSA (Layer 4):&#10;    per-ServiceAccount roles, 1-hour credentials,&#10;    nothing stored anywhere in the cluster." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="760" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="IRSA CANNOT SEE&#10;&#10;Anything inside the lab. It answers &quot;which AWS&#10;role may this pod assume&quot; and nothing else.&#10;&#10;It also introduces a dependency: if Cloudflare&#10;or S3 is down, pods cannot get FRESH credentials.&#10;Cached ones keep working for the rest of their&#10;hour. Vault cannot auto-unseal while KMS is&#10;unreachable — a reboot during an AWS outage&#10;means a sealed Vault and unresolvable&#10;ExternalSecrets. Taken knowingly (ADR-0005)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;arcSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1225" y="860" width="420" height="205" as="geometry" />
        </mxCell>

        <mxCell id="s45" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="600" y="1112" as="sourcePoint" /><mxPoint x="600" y="1130" as="targetPoint" /></mxGeometry>
        </mxCell>
        <!-- Layer 5: identity at the edge (W.5 / 8.1-8.2, ADR-0021) -->
        <mxCell id="l5" value="LAYER 5 — CLOUDFLARE TUNNEL + ACCESS   ·   identity before the request reaches the lab (dash., ADR-0021)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e6;strokeColor=#f38020;verticalAlign=top;align=left;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="1130" width="1160" height="200" as="geometry" />
        </mxCell>
        <mxCell id="z1" value="THE PATH&#10;1. browser → dash.eightbitsaxlounge.com (Cloudflare edge)&#10;2. Access: sign-in, then a signed JWT for this app&#10;3. edge → the tunnel cloudflared dialled OUT (QUIC 7844)&#10;4. cloudflared checks the JWT (access.required, AUD)&#10;   and forwards to the dash Service, nothing else&#10;5. dash&#x27;s NetworkPolicy admits cloudflared only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;fontSize=10;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="370" height="155" as="geometry" />
        </mxCell>
        <mxCell id="z2" value="WHY NOT THE GATEWAY&#10;The Gateway is a LAN VIP (.241). A dash. listener there&#10;would let anyone on VLAN 20 — or anyone who sets a&#10;Host: header — reach the origin around Access. So a&#10;private hostname has no listener, no HTTPRoute and no&#10;Unbound override: the tunnel is the only path, from&#10;home too. A forged JWT gets the same 302 as none." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;fontSize=10;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="425" y="1160" width="370" height="155" as="geometry" />
        </mxCell>
        <mxCell id="z3" value="WHAT IT ADDED, AND WHAT IT COSTS&#10;+ remote access with zero inbound port-forwards&#10;  (external nmap 2026-10-27: 65,534 filtered)&#10;+ identity checked before a packet reaches the lab&#10;− Cloudflare down = dash. down (that is the signal, F8)&#10;− Grafana and Argo CD still on the Gateway, LAN-only:&#10;  moving them is a separate decision (8.2, tabled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;fontSize=10;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="810" y="1160" width="350" height="155" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="ACCESS (LAYER 5) CANNOT SEE&#10;&#10;Anything already inside VLAN 20, or a request to a&#10;service that has its own Gateway listener. It guards&#10;the hostnames routed through the tunnel and only&#10;those — which is why ADR-0021 removes every other&#10;path to them rather than trusting Access to be first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;fontSize=11;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="1225" y="1130" width="420" height="140" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
