---
# Copy to repo-credentials.sops.enc.yaml, fill in, then:
#   sops --encrypt --in-place cluster/argocd/bootstrap/repo-credentials.sops.enc.yaml
#
# The platform repo is private (ADR-0002), so Argo CD needs credentials to read
# it. Use a GitHub App installation token rather than a PAT: it is scoped to the
# org, rotates itself, and is not tied to a human account that might leave.
apiVersion: v1
kind: Secret
metadata:
  name: platform-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/nineteenseventytwo/nineteenseventytwo-platform.git
  githubAppID: "000000"
  githubAppInstallationID: "00000000"
  githubAppPrivateKey: |
    -----BEGIN RSA PRIVATE KEY-----
    ...
    -----END RSA PRIVATE KEY-----
