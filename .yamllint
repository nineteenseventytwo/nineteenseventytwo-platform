---
extends: default

ignore: |
  build/
  charts/
  docs/plan/
  # SOPS owns the formatting of these: it rewrites the whole file on every
  # encrypt, with its own indentation and with comments turned into #ENC[...]
  # lines. Nothing here is hand-edited, so there is nothing for a linter to
  # keep honest.
  *.sops.yml
  *.sops.yaml
  # Vendored verbatim from upstream (kubernetes-sigs/gateway-api releases).
  # Nothing here is hand-edited, so there is nothing for a linter to keep
  # honest - same reasoning as the sops-owned files above.
  cluster/gateway-api-crds/

rules:
  # Helm values and k8s manifests routinely exceed 80 columns.
  line-length:
    max: 160
    level: warning
  # Ansible convention is 2-space indent with sequences indented under the key.
  indentation:
    spaces: 2
    indent-sequences: consistent
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
